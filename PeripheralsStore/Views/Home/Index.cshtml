@model List<Product>
@{
    ViewData["Title"] = "Главная";
}
<section class="hero p-5 rounded-4 mb-4 text-white">
    <h1>Магазин компьютерной периферии</h1>
    <p>Клавиатуры, мыши, наушники и другая периферия по доступным ценам.</p>
    <a class="btn btn-warning" asp-controller="Products" asp-action="Index">Перейти в каталог</a>
</section>
<h2 class="mb-3">Популярные товары</h2>
<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <img src="@(item.ImageUrl ?? "https://via.placeholder.com/500x300")" class="card-img-top" alt="@item.Name">
                <div class="card-body">
                    <h5>@item.Name</h5>
                    <p class="small text-muted">@item.Brand?.Name</p>
                    <p class="fw-bold">@item.Price.ToString("N0") ₽</p>
                    <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Details" asp-route-id="@item.Id">Подробнее</a>
                </div>
            </div>
        </div>
    }
</div>
