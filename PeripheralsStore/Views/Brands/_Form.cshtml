@model BrandCreateEditViewModel
<form method="post" class="card p-3">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" />
<div><label asp-for="Name"></label><input asp-for="Name" maxlength="100" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mt-2"><label asp-for="Country"></label><input asp-for="Country" maxlength="80" class="form-control" /></div>
<button type="submit" class="btn btn-success mt-3">Сохранить</button></form>
<partial name="_ValidationScriptsPartial" />
