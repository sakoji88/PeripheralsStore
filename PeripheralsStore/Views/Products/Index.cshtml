@model List<Product>
@{
    ViewData["Title"] = "Каталог";
    var filter = (ProductFilterViewModel)ViewBag.Filter;
    int totalPages = ViewBag.TotalPages;
}
<h1>Каталог товаров</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="Search" maxlength="120" value="@filter.Search" class="form-control" placeholder="Поиск по названию или артикулу" /></div>
    <div class="col-md-2"><select name="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Категория</option></select></div>
    <div class="col-md-2"><select name="BrandId" asp-items="ViewBag.Brands" class="form-select"><option value="">Бренд</option></select></div>
    <div class="col-md-1"><input type="number" step="0.01" min="0" name="MinPrice" value="@filter.MinPrice" class="form-control" placeholder="От" /></div>
    <div class="col-md-1"><input type="number" step="0.01" min="0" name="MaxPrice" value="@filter.MaxPrice" class="form-control" placeholder="До" /></div>
    <div class="col-md-2"><select name="SortBy" class="form-select">
            <option value="nameAsc">Имя A-Я</option><option value="nameDesc" selected="@(filter.SortBy=="nameDesc")">Имя Я-A</option>
            <option value="priceAsc" selected="@(filter.SortBy=="priceAsc")">Цена ↑</option><option value="priceDesc" selected="@(filter.SortBy=="priceDesc")">Цена ↓</option>
        </select></div>
    <div class="col-md-1 form-check ps-4"><input class="form-check-input" type="checkbox" name="InStockOnly" checked="@filter.InStockOnly" /><label class="form-check-label">В наличии</label></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Применить</button></div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">Ничего не найдено. Измените параметры поиска.</div>
}
else
{
<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100"><img src="@(item.ImageUrl ?? "https://via.placeholder.com/500x300")" class="card-img-top" alt="@item.Name" />
                <div class="card-body">
                    <h5>@item.Name</h5>
                    <p>@item.Price.ToString("N0") ₽</p>
                    <p class="small text-muted">Остаток: @item.StockQuantity</p>
                    <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Карточка</a>
                    @if (User.IsInRole("Admin")) { <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Редактировать</a> }
                </div>
            </div>
        </div>
    }
</div>
<nav class="mt-3"><ul class="pagination">
    @for (int i=1;i<=totalPages;i++)
    {
        <li class="page-item @(i==filter.Page?"active":"")"><a class="page-link" href="?Page=@i&Search=@filter.Search&CategoryId=@filter.CategoryId&BrandId=@filter.BrandId&MinPrice=@filter.MinPrice&MaxPrice=@filter.MaxPrice&InStockOnly=@filter.InStockOnly&SortBy=@filter.SortBy">@i</a></li>
    }
</ul></nav>
}
